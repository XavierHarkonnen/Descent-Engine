{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 26,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_CXX_FLAGS": "-march=native -mtune=native -pipe",
				"CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
				"INTERN_CXX_FLAGS": "-Waddress -Wall -Walloca -Wattributes -Wbuiltin-macro-redefined -Wcast-align -Wconversion -Wdeprecated -Wdeprecated-declarations -Wdiv-by-zero -Wdouble-promotion -Wempty-body -Wendif-labels -Wextra -Wformat -Wformat-extra-args -Wformat-nonliteral -Wformat-zero-length -Wformat=2 -Wignored-qualifiers -Winit-self -Wint-to-pointer-cast -Wmissing-braces -Wmissing-declarations -Wmissing-field-initializers -Wmissing-noreturn -Wmultichar -Wnonnull -Wnull-dereference -Woverflow -Wparentheses -Wpedantic -Wpointer-arith -Wredundant-decls -Wreturn-type -Wsequence-point -Wshadow -Wsign-compare -Wsizeof-array-argument -Wstrict-aliasing -Wstrict-overflow -Wstrict-overflow=2 -Wswitch -Wtautological-compare -Wtrigraphs -Wtype-limits -Wundef -Wuninitialized -Wunknown-pragmas -Wunused -Wunused-function -Wunused-label -Wunused-parameter -Wunused-value -Wunused-variable -Wvla -Wwrite-strings -Wimplicit-fallthrough -Wextra-semi -Wcomma -Wunreachable-code -Wloop-analysis -Wundefined-func-template"
			}
		},
		{
			"name": "tests",
			"hidden": true,
			"cacheVariables": {
				"DESCENT_BUILD_TESTS": "ON"
			}
		},
		{
			"name": "debug",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_FLAGS_DEBUG": "-DDESCENT_DEBUG -g -Og -fsanitize=undefined -fno-sanitize-recover=all -ftrivial-auto-var-init=pattern"
			}
		},
		{
			"name": "release",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_CXX_FLAGS_RELEASE": "-O2 -fomit-frame-pointer -flto",
				"CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
			}
		},
		{
			"name": "release-debug",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-g -O2 -flto"
			}
		},
		{
			"name": "release-size",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "MinSizeRel",
				"CMAKE_CXX_FLAGS_MINSIZEREL": "-Os -flto"
			}
		},
		{
			"name": "debug-test",
			"inherits": [
				"debug",
				"tests"
			]
		},
		{
			"name": "release-test",
			"inherits": [
				"release",
				"tests"
			]
		},
		{
			"name": "release-debug-test",
			"inherits": [
				"release-debug",
				"tests"
			]
		},
		{
			"name": "release-size-test",
			"inherits": [
				"release-size",
				"tests"
			]
		},
		{
			"name": "asan-test",
			"inherits": "debug-test",
			"cacheVariables": {
				"CMAKE_CXX_FLAGS_DEBUG": "-DDESCENT_DEBUG -g -O1 -fno-omit-frame-pointer -fsanitize=address,undefined -fsanitize-address-use-after-return=never -fno-sanitize-recover=all"
			}
		},
		{
			"name": "tsan-test",
			"inherits": "debug-test",
			"cacheVariables": {
				"CMAKE_CXX_FLAGS_DEBUG": "-DDESCENT_DEBUG -g -O1 -fno-omit-frame-pointer -fsanitize=thread"
			}
		}
	],
	"buildPresets": [
		{
			"name": "debug",
			"configurePreset": "debug"
		},
		{
			"name": "release",
			"configurePreset": "release"
		},
		{
			"name": "release-debug",
			"configurePreset": "release-debug"
		},
		{
			"name": "release-size",
			"configurePreset": "release-size"
		},
		{
			"name": "debug-test",
			"configurePreset": "debug-test"
		},
		{
			"name": "release-test",
			"configurePreset": "release-test"
		},
		{
			"name": "release-debug-test",
			"configurePreset": "release-debug-test"
		},
		{
			"name": "release-size-test",
			"configurePreset": "release-size-test"
		},
		{
			"name": "asan-test",
			"configurePreset": "asan-test"
		},
		{
			"name": "tsan-test",
			"configurePreset": "tsan-test"
		}
	],
	"testPresets": [
		{
			"name": "debug-test",
			"configurePreset": "debug-test",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "release-test",
			"configurePreset": "release-test",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "release-debug-test",
			"configurePreset": "release-debug-test",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "release-size-test",
			"configurePreset": "release-size-test",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "asan-test",
			"configurePreset": "asan-test",
			"output": {
				"outputOnFailure": true
			},
			"environment": {
				"ASAN_OPTIONS": "detect_leaks=1",
				"UBSAN_OPTIONS": "print_stacktrace=1"
			}
		},
		{
			"name": "tsan-test",
			"configurePreset": "tsan-test",
			"output": {
				"outputOnFailure": true
			},
			"environment": {
				"TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
			}
		}
	]
}
